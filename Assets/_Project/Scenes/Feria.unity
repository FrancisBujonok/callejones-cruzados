  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 2dda0387e74e5a24db90413feced8998, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::FortuneTeller
  price: 3
  seat: {fileID: 1862284052}
  promptDistance: 2
  ballLight: {fileID: 1867996395}
  chimes: {fileID: 1829194266}
  before:
  - Me agarra las manos y las da vuelta. Las mira un rato largo.
  - "Despu\xE9s me habla. En castellano."
  - "\xABNo sos de ac\xE1. Pero vas a conocer estas calles mejor que yo.\xBB"
  fortunes:
  - "\xABCuando las calles cambien, no te des vuelta para comprobarlo.\xBB"
  - "\xABEl gato sabe d\xF3nde est\xE1 la salida. Vos todav\xEDa no.\xBB"
  - "\xABVas a pasar tres veces por el mismo lugar. A la tercera, mir\xE1 arriba.\xBB"
  - "\xABLo que te sigue no camina. Espera.\xBB"
  after: "Nadie m\xE1s en la feria me habl\xF3 en castellano."
  paperLine: Me escribe la frase en un papelito y me lo da.
  againLine: "La adivina me hace un gesto con la mano: ya est\xE1, que me vaya."
